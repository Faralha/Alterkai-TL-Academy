---
import type { Props } from '@astrojs/starlight/props';
import { getCollection } from 'astro:content';
import { Icon } from '@astrojs/starlight/components';

// Prev/next cards with the target page's description, like the old Nuxt navigator.
const { pagination } = Astro.props;
const { prev, next } = pagination;

const docs = await getCollection('docs');
const bySlug = new Map(docs.map((d) => [d.id.replace(/\.mdx?$/, ''), d.data]));
const descFor = (href: string) => bySlug.get(href.replace(/^\/+|\/+$/g, ''))?.description;

const links = [
  prev && { ...prev, rel: 'prev', caption: Astro.locals.t('page.previousLink'), icon: 'left-arrow' as const },
  next && { ...next, rel: 'next', caption: Astro.locals.t('page.nextLink'), icon: 'right-arrow' as const },
].filter(Boolean) as Array<NonNullable<typeof prev> & { rel: string; caption: string; icon: 'left-arrow' | 'right-arrow' }>;
---

<div class="pagination-links ak-pagination">
  {
    links.map((link) => {
      const desc = descFor(link.href);
      return (
        <a href={link.href} rel={link.rel}>
          <Icon name={link.icon} size="1.5rem" />
          <span>
            {link.caption}
            <br />
            <span class="link-title">{link.label}</span>
            {desc && <span class="ak-pagination-desc">{desc}</span>}
          </span>
        </a>
      );
    })
  }
</div>

<style>
  .pagination-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
    gap: 1rem;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    width: 100%;
    padding: 1rem;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  [rel='next'] {
    justify-content: end;
    text-align: end;
    flex-direction: row-reverse;
  }

  .link-title {
    font-size: var(--sl-text-2xl);
    line-height: var(--sl-line-height-headings);
  }

  svg {
    flex-shrink: 0;
  }
</style>
